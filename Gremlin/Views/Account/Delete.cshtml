@{
    ViewData["Title"] = "Slett konto";
}

<div class="container mt-4">
    <h2>Delete account</h2>
    <p class="text-danger">Are you sure you want to delete the account? This will delete all quizzes and history.</p>

    <form asp-controller="Account" asp-action="DeleteConfirmed" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Yes, delete the account</button>
        <a asp-action="Update" class="btn btn-secondary">cancel</a>
    </form>
</div>