@model Gremlin.ViewModels.UserViewModel

@{
    ViewData["Title"] = Model.User.UserName ?? "User Profile";
}

<div class="container py-5">
    <!-- --- Profile Header --- -->
    <div class="card border-0 shadow-sm rounded-4 mb-5 bg-light">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="text-start">
                <h2 class="fw-bold mb-1">@(Model.User.UserName ?? "My Profile")</h2>
                <p class="text-muted mb-0">
                    <span class="fw-semibold text-dark">@(Model.User.Email ?? "")</span>
                </p>
            </div>
            <div class="d-flex gap-3">
                <div class="bg-white px-4 py-2 rounded-3 shadow-sm text-center">
                    <div class="fs-4 fw-bold text-primary">@Model.Quizzes.Count()</div>
                    <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Created</small>
                </div>
                <div class="bg-white px-4 py-2 rounded-3 shadow-sm text-center">
                    <div class="fs-4 fw-bold text-success">@Model.Histories.Count()</div>
                    <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Completed</small>
                </div>
            </div>
        </div>
    </div>

    <!-- --- Section 1: Created Quizzes --- -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">My Quizzes</h4>
        <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Quiz" asp-action="Create">
            + Create New Quiz
        </a>
    </div>

    @if (!Model.Quizzes.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 mb-5">
            <div class="card-body">
                <p class="text-muted mb-3">You haven't created any quizzes yet.</p>
                <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Quiz" asp-action="Create">
                    Create Your First Quiz
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var quiz in Model.Quizzes)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body d-flex flex-column justify-content-between p-4">
                            <div>
                                <h5 class="card-title fw-bold fs-5 mb-2">@quiz.title</h5>
                            </div>

                            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                                <a class="btn btn-outline-primary btn-sm w-100 rounded-3" 
                                asp-controller="Quiz" asp-action="Update" asp-route-id="@quiz.id">
                                    Update
                                </a>
                                <form asp-controller="Quiz" asp-action="Delete" asp-route-id="@quiz.id" method="post" class="w-100 m-0" onsubmit="return confirm('Are you sure you want to delete this quiz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-3">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- --- Section 2: Quiz History / Attempt Log --- -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-3">Quiz History</h4>
    </div>

    @if (!Model.Histories.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <p class="text-muted mb-0">You haven't taken any quizzes yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-secondary">
                        <tr>
                            <th class="ps-4 py-3">Quiz Title</th>
                            <th class="py-3">Score</th>
                            <th class="py-3">Performance</th>
                            <th class="pe-4 py-3 text-end">Completed On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var history in Model.Histories)
                        {
                                var score = history.score ?? 0;
                                var maxScore = history.maxPossibleScore > 0 ? history.maxPossibleScore.Value : 1;
                                var percentage = (int)Math.Round(((double)score / maxScore) * 100);

                                // Color-code badge based on score percentage
                                string badgeVariant = "bg-danger";
                                if (percentage >= 80)
                                {
                                    badgeVariant = "bg-success";
                                }

                                else if (percentage >= 50)
                                {
                                    badgeVariant = "bg-warning text-dark";
                                }
                            <tr>
                                <td class="ps-4 py-3 fw-semibold text-dark">
                                    @(history.quiz_title ?? $"Quiz #{history.quiz_id}")
                                </td>
                                <td class="py-3">
                                    <span class="fw-bold">@history.score</span>
                                    <span class="text-muted"> / @history.maxPossibleScore</span>
                                </td>
                                <td class="py-3">
                                    <span class="badge @badgeVariant rounded-pill px-3 py-1">
                                        @percentage%
                                    </span>
                                </td>
                                <td class="pe-4 py-3 text-end text-muted small">
                                    @(history.completed_at?.ToString("MMM dd, yyyy") ?? "N/A")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Account Settings Actions (Optional, matches your bottom buttons) -->
    <div class="mt-5 d-flex gap-2">
        <a class="btn btn-outline-secondary rounded-pill px-4" asp-controller="Account" asp-action="Update">Update Profile</a>
        <form asp-controller="Account" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete your account?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger rounded-pill px-4">Delete Account</button>
        </form>
    </div>
</div>