@model Gremlin.ViewModels.TakequizViewModel

@{
    ViewData["Title"] = Model.QuizTitle ?? "Take Quiz";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4">@Model.QuizTitle</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger" role="alert">
                    <div asp-validation-summary="All" class="text-danger"></div>
                </div>
            }

            <form asp-controller="Quiz" asp-action="Submit" asp-route-QuizId="@Model.QuizId" method="post">
                @Html.AntiForgeryToken()

                
                <input type="hidden" asp-for="QuizId" />
                <input type="hidden" asp-for="QuizTitle" />

                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">Question @(i + 1)</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text fw-bold fs-5">@Model.Questions[i].Title</p>

                            <!-- Hidden inputs to preserve question metadata during POST binding -->
                            <input type="hidden" asp-for="Questions[i].QuestionId" />
                            <input type="hidden" asp-for="Questions[i].Title" />

                            <div class="list-group mt-3">
                                @for (int j = 0; j < Model.Questions[i].AnswerAlternatives.Count; j++)
                                {
                                    string optionId = $"question_{i}_option_{j}";

                                    <!-- Hidden input to bind the text of answer alternatives back -->
                                    <input type="hidden" name="Questions[@i].AnswerAlternatives[@j]" value="@Model.Questions[i].AnswerAlternatives[j]" />

                                    <div class="form-check list-group-item list-group-item-action d-flex align-items-center ps-4">
                                        <input class="form-check-input me-3" 
                                               type="radio" 
                                               id="@optionId" 
                                               asp-for="Questions[i].SelectedAnswerIndex" 
                                               value="@j" />
                                        <label class="form-check-label w-100 py-2 cursor-pointer" for="@optionId">
                                            @Model.Questions[i].AnswerAlternatives[j]
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex justify-content-between mb-5">
                    <a asp-controller="Quiz" asp-action="Table" class="btn btn-secondary btn-lg">Cancel</a>
                    <button type="submit" class="btn btn-success btn-lg">Submit Quiz</button>
                </div>
            </form>
        </div>
    </div>
</div>