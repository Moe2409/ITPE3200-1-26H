@model User

<h2>Update User</h2>
<form asp-action="Update">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="DisplayName"></label><span class="text-danger">*</span>
        <input asp-for="DisplayName" class="form-control" />
        <span asp-validation-for="DisplayName" class="text-danger"></span>
    </div>
    <div>
        <!--<label asp-for="Password"></label><span class="text-danger">*</span>
        <input asp-for="password_hash" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>-->
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Details" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}