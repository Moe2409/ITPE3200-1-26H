@model IdentityUser

<h2>Create New User</h2>
<form asp-action="Create">
    <div class="form-group">
        <label asp-for="UserName"></label><span class="text-danger">*</span>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>
    <div>
       <!-- <label asp-for="password_hash"></label><span class="text-danger">*</span>
        <input asp-for="password_hash" class="form-control" />
        <span asp-validation-for="password_hash" class="text-danger"></span>-->
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}